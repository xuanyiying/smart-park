# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git make protobuf

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build charging service
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/charging-svc ./cmd/charging

# Final stage
FROM alpine:latest

WORKDIR /app

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /app/charging-svc .

# Copy configuration
COPY configs/charging.yaml /app/configs/charging.yaml

# Expose ports (HTTP 8005, gRPC 9005)
EXPOSE 8005 9005

# Run the binary
CMD ["./charging-svc", "-conf", "/app/configs/charging.yaml"]
